    {
      "id": "w3",
      "from": {
        "cid": "reset",
        "pid": "out"
      },
      "to": {
        "cid": "cnt",
        "pid": "reset"
      }
    },
    {
      "id": "w4",
      "from": {
        "cid": "cnt",
        "pid": "q0"
      },
      "to": {
        "cid": "out",
        "pid": "d0"
      }
    },
    {
