      "id": "w0",
      "from": {
        "cid": "enable",
        "pid": "out"
      },
      "to": {
        "cid": "clk",
        "pid": "en"
      }
    },
    {
      "id": "w1",
      "from": {
        "cid": "clk",
        "pid": "out"
      },
      "to": {
        "cid": "cnt",
        "pid": "clk"
      }
    },
    {
      "id": "w2",
      "from": {
        "cid": "enable",
        "pid": "out"
      },
      "to": {
        "cid": "cnt",
        "pid": "en"
      }
