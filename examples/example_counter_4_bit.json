{
  "title": "Четырёхбитный счётчик",
  "description": "EN=1, RST=0. Тактовый генератор увеличивает счётчик по положительному фронту. Выходы Q0–Q3 отображаются числовым дисплеем.",
  "components": [
    {
      "id": "clk",
      "type": "clock",
      "x": 80,
      "y": 120
    },
    {
      "id": "enable",
      "type": "const1",
      "x": 80,
      "y": 300
    },
    {
      "id": "reset",
      "type": "const0",
      "x": 80,
      "y": 480
    },
    {
      "id": "cnt",
      "type": "counter",
      "x": 390,
      "y": 120,
      "props": {
        "bitWidth": 4
      },
      "state": {
        "value": 0
      }
    },
    {
      "id": "out",
      "type": "display",
      "x": 700,
      "y": 120,
      "props": {
        "bitWidth": 4
      }
    }
  ],
  "wires": [
